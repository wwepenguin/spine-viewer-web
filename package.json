    "@pixi/prepare": "6.3.2",
    "@pixi/runner": "6.3.2",
    "@pixi/settings": "6.3.2",
    "@pixi/sprite": "6.3.2",
    "@pixi/sprite-animated": "6.3.2",
    "@pixi/sprite-tiling": "6.3.2",
    "@pixi/spritesheet": "6.3.2",
    "@pixi/text": "6.3.2",
    "@pixi/text-bitmap": "6.3.2",
    "@pixi/ticker": "6.3.2",
    "@pixi/utils": "6.3.2"
